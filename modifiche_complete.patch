+  var per = document.getElementById('id_costo_token_periodicita');
+  var amb = document.getElementById('id_costo_token_ambito');
+  var box = document.querySelector('[data-annuo]');
+  if(!cost || !per || !box) return;
+  var out = box.querySelector('b');
+  var utenti = parseInt(box.getAttribute('data-utenti') || '0', 10);
+  function fmt(n){ return '€ ' + n.toLocaleString('it-IT', {minimumFractionDigits:2, maximumFractionDigits:2}); }
+  function calc(){
+    var v = parseFloat((cost.value || '').replace(',', '.'));
+    if(isNaN(v)){ out.textContent = '—'; return; }
+    var p = per.value, annuo;
+    if(p === 'MENSILE'){ annuo = v * 12; }
+    else if(p === 'ANNUALE'){ annuo = v; }
+    else if(p === 'UNA_TANTUM'){ out.textContent = fmt(v) + ' una tantum (non ricorrente)'; return; }
+    else { out.textContent = 'indica la periodicità'; return; }
+    var ambVal = (amb && amb.value) ? amb.value : '';
