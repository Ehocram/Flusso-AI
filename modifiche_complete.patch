+      txt += ' · totale ' + fmt(annuo * utenti) + '/anno (' + utenti + ' utenti)';
+    }
+    out.textContent = txt;
+  }
+  cost.addEventListener('input', calc);
+  cost.addEventListener('change', calc);
+  per.addEventListener('change', calc);
+  if(amb) amb.addEventListener('change', calc);
+  calc();
+})();
