# Reverse proxy interno con TLS dalla CA interna di Caddy.
# L'hostname (o IP) si imposta da .env con SITE_ADDRESS, senza editare questo file.
# Per usare un certificato della PKI aziendale, rimpiazzare 'tls internal'
# con:  tls /etc/caddy/cert.pem /etc/caddy/key.pem
{$SITE_ADDRESS:flussoai.iseo.local} {
    encode zstd gzip
    tls internal
    reverse_proxy web:8000
}
