+        var html = tpl.innerHTML.replace(/__prefix__/g, idx).trim();
+        var wrap = document.createElement('div');
+        wrap.innerHTML = html;
+        rows.appendChild(wrap.firstElementChild);
+        total.value = idx + 1;
+      });
+    }
+  });
