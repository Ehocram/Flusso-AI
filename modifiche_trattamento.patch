+<script>
+(function(){
+  document.querySelectorAll('form[data-trk]').forEach(function(form){
+    var sel = form.querySelector('select[name$="-strategia"]');
+    var blkAz = form.querySelector('[data-trk-azioni]');
+    var blkRes = form.querySelector('[data-trk-residuo]');
+    function apply(){
+      var v = sel ? sel.value : 'ACCETTATO';
+      if(blkAz) blkAz.style.display = (v === 'MITIGATO') ? '' : 'none';
+      if(blkRes) blkRes.style.display = (v === 'MITIGATO' || v === 'TRASFERITO') ? '' : 'none';
+    }
+    if(sel) sel.addEventListener('change', apply);
+    apply();
+
+    var addBtn = form.querySelector('[data-add-row]');
+    var rows = form.querySelector('[data-formset-rows]');
